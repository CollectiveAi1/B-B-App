# Copy to .env.local for local development. On Vercel, set these as project
# environment variables instead. Both are read on the server only and are never
# sent to the browser.

# Gemini API key from https://aistudio.google.com/apikey
# Leave unset to run on the built-in demo responder (no network calls, no key needed).
GEMINI_API_KEY=

# Optional. Model that writes guest replies. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. The Gemini SDK calls the stable v1 API by default. Set this to "beta"
# if a feature you rely on is only on the beta API.
# GOOGLE_GENAI_API_VERSION=beta
